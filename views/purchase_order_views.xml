<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Purchase Order Form View for Logistics Stages, Freight/Warehouse, Checklist, and Lot Expiry -->
    <record id="purchase_order_form_inherit_lot_expiry" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.lot.expiry</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Replace standard statusbar with Logistics Stage pipeline statusbar up to PI -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="replace">
                <field name="state" invisible="1"/>
                <field name="logistics_stage" widget="statusbar" statusbar_visible="rfq,po,manufacturing,expiry_check,pi" readonly="1"/>
            </xpath>

            <!-- Show default Upload Bill widget and Create Bill button in PI Stage -->
            <xpath expr="//header/widget[@name='purchase_file_uploader']" position="attributes">
                <attribute name="invisible">state in ('draft', 'sent', 'to approve', 'cancel') or logistics_stage != 'pi'</attribute>
            </xpath>
            <xpath expr="//header/widget[@name='purchase_file_uploader']" position="after">
                <button name="action_create_invoice" string="إنشاء الفاتورة (Create Bill)" type="object" class="btn btn-secondary" invisible="state in ('draft', 'sent', 'to approve', 'cancel') or logistics_stage != 'pi' or invoice_status in ('invoiced')"/>
            </xpath>

            <!-- Show Bill Matching smart button in PI Stage -->
            <xpath expr="//button[@name='action_bill_matching']" position="attributes">
                <attribute name="invisible">state in ('draft', 'sent', 'to approve', 'cancel') or logistics_stage != 'pi'</attribute>
                <attribute name="groups"></attribute>
            </xpath>

            <!-- Header Stage Action Buttons & Print Lot QR Labels Button -->
            <xpath expr="//header" position="inside">
                <!-- Sequential Logistics Stage Buttons up to PI -->
                <button name="action_stage_manufacturing" string="بدء التصنيع (Manufacturing)" type="object" class="btn btn-primary" icon="fa-industry" invisible="logistics_stage != 'po' or state in ('draft', 'cancel')"/>
                <button name="action_stage_expiry_check" string="تدقيق تواريخ التلف (Expiry Check)" type="object" class="btn btn-primary" icon="fa-calendar-check-o" invisible="logistics_stage != 'manufacturing' or state in ('draft', 'cancel')"/>
                <button name="action_stage_pi" string="فاتورة شراء (PI)" type="object" class="btn btn-primary" icon="fa-file-text-o" invisible="logistics_stage != 'expiry_check' or state in ('draft', 'cancel')"/>
                <button name="action_stage_previous" string="المرحلة السابقة" type="object" class="btn btn-outline-secondary" icon="fa-arrow-left" title="التراجع إلى المرحلة السابقة" invisible="logistics_stage in ('rfq', 'po') or state in ('draft', 'cancel')"/>

                <!-- QR Labels Button -->
                <button name="action_open_lot_qr_wizard" type="object" string="Print Lot QR Labels" class="btn btn-secondary" icon="fa-qrcode"/>
            </xpath>

            <!-- Freight Type & Destination Warehouse Section -->
            <xpath expr="//sheet/group[1]" position="after">
                <group string="بيانات الشحن والمستودع المستلم (Logistics &amp; Warehouse Destination)">
                    <group>
                        <field name="freight_type" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <group>
                        <field name="destination_warehouse_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="picking_type_id" string="عملية الاستلام (Receipt Operation)" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>
            </xpath>


            <!-- Add Lot, Expiry fields, and Redistribute Button in Order Line list view -->
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="product_tracking" column_invisible="True"/>
                <field name="show_redistribute_button" column_invisible="True"/>
                <field name="lot_ids" widget="many2many_tags" optional="show" domain="[('product_id', '=', product_id)]" context="{'default_product_id': product_id}" options="{'no_quick_create': True}" invisible="not product_tracking or product_tracking == 'none'"/>
                <field name="expiration_date" optional="hide" invisible="not product_tracking or product_tracking == 'none'"/>
                <field name="lot_expiry_display" widget="badge" decoration-info="1" optional="show" invisible="not product_tracking or product_tracking == 'none'"/>
                <button name="action_open_lot_redistribution_wizard" type="object" icon="fa-balance-scale" title="Redistribute Lot Quantities" invisible="not show_redistribute_button" string="Redistribute"/>
            </xpath>

            <!-- Add Lot and Expiry fields in Order Line form view -->
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="after">
                <field name="product_tracking" invisible="1"/>
                <field name="show_redistribute_button" invisible="1"/>
                <field name="lot_ids" widget="many2many_tags" domain="[('product_id', '=', product_id)]" context="{'default_product_id': product_id}" options="{'no_quick_create': True}" invisible="not product_tracking or product_tracking == 'none'"/>
                <field name="expiration_date" invisible="not product_tracking or product_tracking == 'none'"/>
                <field name="lot_expiry_display" widget="badge" decoration-info="1" invisible="not product_tracking or product_tracking == 'none'"/>
                <button name="action_open_lot_redistribution_wizard" type="object" icon="fa-balance-scale" title="Redistribute Lot Quantities" invisible="not show_redistribute_button" string="Redistribute Lot Qty" class="btn btn-secondary mt-2"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Purchase Order KPI Tree View to show Logistics Stage and Freight Type -->
    <record id="purchase_order_kpis_tree_inherit_logistics" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.inherit.logistics</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="freight_type" optional="show" widget="badge"/>
                <field name="destination_warehouse_id" optional="show"/>
                <field name="logistics_stage" widget="badge" decoration-info="logistics_stage in ('po', 'manufacturing', 'expiry_check')" decoration-success="logistics_stage == 'pi'" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Purchase Order Standard Tree View -->
    <record id="purchase_order_view_tree_inherit_logistics" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.inherit.logistics</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="freight_type" optional="show" widget="badge"/>
                <field name="destination_warehouse_id" optional="show"/>
                <field name="logistics_stage" widget="badge" decoration-info="logistics_stage in ('po', 'manufacturing', 'expiry_check')" decoration-success="logistics_stage == 'pi'" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Purchase Order Search View for Filters and Groupings -->
    <record id="purchase_order_view_search_inherit_logistics" model="ir.ui.view">
        <field name="name">purchase.order.view.search.inherit.logistics</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="بحرية / Sea Freight" name="freight_sea" domain="[('freight_type', '=', 'sea')]"/>
                <filter string="جوية / Air Freight" name="freight_air" domain="[('freight_type', '=', 'air')]"/>
                <separator/>
                <filter string="قيد التصنيع (Manufacturing)" name="stage_manufacturing" domain="[('logistics_stage', '=', 'manufacturing')]"/>
                <filter string="تدقيق تواريخ التلف (Expiry Check)" name="stage_expiry_check" domain="[('logistics_stage', '=', 'expiry_check')]"/>
                <filter string="فاتورة شراء (PI)" name="stage_pi" domain="[('logistics_stage', '=', 'pi')]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="نوع الشحن (Freight Type)" name="group_by_freight_type" context="{'group_by': 'freight_type'}"/>
                <filter string="مرحلة الشحنة (Logistics Stage)" name="group_by_logistics_stage" context="{'group_by': 'logistics_stage'}"/>
                <filter string="المخزن المستلم (Warehouse)" name="group_by_destination_warehouse" context="{'group_by': 'destination_warehouse_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Purchase Order Line List View -->
    <record id="purchase_order_line_tree_inherit_lot_expiry" model="ir.ui.view">
        <field name="name">purchase.order.line.list.inherit.lot.expiry</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="product_tracking" column_invisible="True"/>
                <field name="show_redistribute_button" column_invisible="True"/>
                <field name="lot_ids" widget="many2many_tags" optional="show" options="{'no_quick_create': True}" invisible="not product_tracking or product_tracking == 'none'"/>
                <field name="expiration_date" optional="hide" invisible="not product_tracking or product_tracking == 'none'"/>
                <field name="lot_expiry_display" widget="badge" decoration-info="1" optional="show" invisible="not product_tracking or product_tracking == 'none'"/>
                <button name="action_open_lot_redistribution_wizard" type="object" icon="fa-balance-scale" title="Redistribute Lot Quantities" invisible="not show_redistribute_button"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Purchase Order Line Form View -->
    <record id="purchase_order_line_form2_inherit_lot_expiry" model="ir.ui.view">
        <field name="name">purchase.order.line.form2.inherit.lot.expiry</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_unit']" position="after">
                <field name="product_tracking" invisible="1"/>
                <field name="show_redistribute_button" invisible="1"/>
                <field name="lot_ids" widget="many2many_tags" domain="[('product_id', '=', product_id)]" options="{'no_quick_create': True}" invisible="not product_tracking or product_tracking == 'none'"/>
                <field name="expiration_date" invisible="not product_tracking or product_tracking == 'none'"/>
                <field name="lot_expiry_display" widget="badge" decoration-info="1" invisible="not product_tracking or product_tracking == 'none'"/>
                <button name="action_open_lot_redistribution_wizard" type="object" icon="fa-balance-scale" title="Redistribute Lot Quantities" invisible="not show_redistribute_button" string="Redistribute Lot Qty" class="btn btn-secondary mt-2"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Stock Picking Form View to display QR buttons, scanning input, Lot Tags, and Expiry Badges -->
    <record id="view_picking_form_inherit_lot_expiry" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.lot.expiry</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Header Actions for Scanning and QR Labels -->
            <xpath expr="//header" position="inside">
                <field name="picking_type_code" invisible="1"/>
                <button name="action_open_receipt_qr_scan_wizard" type="object" string="Scan Receipt QR" class="btn btn-primary" icon="fa-barcode" invisible="state in ('done', 'cancel') or picking_type_code != 'incoming'"/>
                <button name="action_open_receipt_mobile_qr_scan_wizard" type="object" string="Scan via Mobile" class="btn btn-outline-primary" icon="fa-camera" groups="purchase_lot_expiry.group_mobile_qr_scan" invisible="state in ('done', 'cancel') or picking_type_code != 'incoming'"/>
                <button name="action_open_purchase_lot_qr_wizard" type="object" string="Print Lot QR Labels" class="btn btn-secondary" icon="fa-qrcode" invisible="picking_type_code != 'incoming'"/>
            </xpath>

            <!-- Inline Fast Scanner Bar above notebook -->
            <xpath expr="//notebook" position="before">
                <field name="picking_type_code" invisible="1"/>
                <div class="card p-2 mb-3 bg-light border-0 shadow-sm" invisible="state in ('done', 'cancel') or picking_type_code != 'incoming'">
                    <div class="row g-2 align-items-center">
                        <div class="col-auto">
                            <span class="badge bg-primary fs-6"><i class="fa fa-qrcode me-1"/> Fast QR Scan</span>
                        </div>
                        <div class="col-md-6 col-12 d-flex">
                            <field name="qr_scan_input" placeholder="Scan Lot / Product QR Code here..." class="form-control form-control-sm me-2"/>
                            <button name="action_process_qr_scan" type="object" string="Scan" class="btn btn-sm btn-primary" icon="fa-barcode"/>
                        </div>
                        <div class="col-md-4 col-12">
                            <field name="qr_scan_status" widget="char" readonly="1" class="text-success fw-bold small" invisible="not qr_scan_status"/>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- Operations lines lot attributes -->
            <xpath expr="//field[@name='move_ids']/list//field[@name='lot_ids']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="options">{'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list//field[@name='lot_ids']" position="before">
                <field name="product_tracking" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list//field[@name='lot_ids']" position="attributes">
                <attribute name="invisible">not product_tracking or product_tracking == 'none'</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list//field[@name='lot_ids']" position="after">
                <field name="lot_expiry_display" widget="badge" decoration-info="1" optional="show" invisible="not product_tracking or product_tracking == 'none'"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Stock Move Tree View -->
    <record id="view_move_tree_inherit_lot_expiry" model="ir.ui.view">
        <field name="name">stock.move.list.inherit.lot.expiry</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom']" position="after">
                <field name="product_tracking" column_invisible="True"/>
                <field name="lot_ids" widget="many2many_tags" optional="show" options="{'no_quick_create': True}" invisible="not product_tracking or product_tracking == 'none'"/>
                <field name="lot_expiry_display" widget="badge" decoration-info="1" optional="show" invisible="not product_tracking or product_tracking == 'none'"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Stock Move Form View -->
    <record id="view_move_form_inherit_lot_expiry" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.lot.expiry</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_tracking" invisible="1"/>
                <field name="lot_ids" widget="many2many_tags" options="{'no_quick_create': True}" invisible="not product_tracking or product_tracking == 'none'"/>
                <field name="lot_expiry_display" widget="badge" decoration-info="1" invisible="not product_tracking or product_tracking == 'none'"/>
            </xpath>
        </field>
    </record>
</odoo>

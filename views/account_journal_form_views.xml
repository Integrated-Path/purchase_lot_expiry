<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_journal_form_inherit_views" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.views</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_self_billing']" position="after">
                <field name="allowed_users" widget="many2many_tags" />
            </xpath>
        </field>
    </record>
</odoo>
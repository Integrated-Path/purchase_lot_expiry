<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="purchase_lot_expiry.MobileQrCameraScanner">
        <div class="o_mobile_camera_qr_wrapper d-flex flex-column align-items-center w-100">
            <!-- Viewport Box -->
            <div class="position-relative w-100 rounded-3 overflow-hidden shadow bg-black" style="max-width: 440px; min-height: 290px;">
                <div t-att-id="this.scannerId" t-ref="scannerContainer" class="w-100 h-100" style="min-height: 290px;"/>

                <!-- Laser Target Reticle Overlay -->
                <div t-if="state.isReady" class="position-absolute top-50 start-50 translate-middle pointer-events-none" style="width: 210px; height: 210px; border: 2px dashed rgba(46, 204, 113, 0.9); border-radius: 18px; pointer-events: none;">
                    <div class="w-100 h-100 position-relative overflow-hidden">
                        <div class="o_scan_laser"/>
                    </div>
                </div>

                <!-- Processing Spinner Overlay -->
                <div t-if="state.isProcessing" class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center" style="background: rgba(0,0,0,0.45); z-index: 10;">
                    <div class="spinner-grow text-success" role="status">
                        <span class="visually-hidden">Scanning...</span>
                    </div>
                </div>
            </div>

            <!-- Realtime Status Banner -->
            <div class="w-100 mt-2" style="max-width: 440px;">
                <div t-attf-class="alert alert-#{state.statusType} d-flex align-items-center p-2 mb-0 shadow-sm" role="alert">
                    <i t-attf-class="fa #{state.statusType == 'success' ? 'fa-check-circle text-success' : (state.statusType == 'danger' ? 'fa-times-circle text-danger' : 'fa-camera text-primary')} fs-5 me-2"/>
                    <div class="flex-grow-1 fw-bold small text-truncate" t-esc="state.statusMsg"/>
                    <span t-if="state.scanCount > 0" class="badge bg-success ms-1">
                        <t t-esc="state.scanCount"/> scanned
                    </span>
                </div>
            </div>
        </div>
    </t>
</templates>

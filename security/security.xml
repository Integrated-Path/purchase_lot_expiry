<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Category -->
    <record id="module_category_mobile_qr" model="ir.module.category">
        <field name="name">Inventory Mobile Operations</field>
        <field name="sequence">30</field>
        <field name="parent_id" ref="base.module_category_supply_chain"/>
    </record>

    <!-- 2. Privilege (Odoo 19) -->
    <record id="res_groups_privilege_mobile_qr" model="res.groups.privilege">
        <field name="name">Mobile Scanner</field>
        <field name="category_id" ref="module_category_mobile_qr"/>
        <field name="sequence">1</field>
    </record>

    <!-- 3. Security Group -->
    <record id="group_mobile_qr_scan" model="res.groups">
        <field name="name">Mobile QR Scanning Access</field>
        <field name="privilege_id" ref="res_groups_privilege_mobile_qr"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Auto-grant to System Administrators -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mobile_qr_scan'))]"/>
    </record>
    
    <record id="rule_purchase_order_journal_access" model="ir.rule">
        <field name="name">Restrict PO by Journal Access</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[] if user.has_group('base.group_system') else ['|', ('purchase_journal', '=', False), ('purchase_journal.allowed_users', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_account_move_purchase_journal_access" model="ir.rule">
        <field name="name">Restrict Vendor Bills by Journal Access</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[] if user.has_group('base.group_system') else ['|', ('move_type', 'not in', ('in_invoice', 'in_refund')), '|', ('purchase_journal', '=', False), ('purchase_journal.allowed_users', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>

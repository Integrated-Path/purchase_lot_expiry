<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Odoo 19 Security Architecture: res.groups.privilege replaces ir.module.category -->
        <record id="res_groups_privilege_purchase_lot" model="res.groups.privilege">
            <field name="name">Purchase Lot Management</field>
            <field name="sequence">20</field>
        </record>

        <!-- Group definition using privilege_id for Odoo 19 -->
        <record id="group_purchase_mass_create_lot" model="res.groups">
            <field name="name">Mass Create Lot Numbers</field>
            <field name="privilege_id" ref="res_groups_privilege_purchase_lot"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Allows user to mass generate lot and serial numbers directly on Purchase Orders.</field>
        </record>
    </data>
</odoo>
